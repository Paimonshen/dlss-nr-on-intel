#version 450
/*
 * attention — the row-wise operators: the cosine publish and the bit-affine softmax.
 *
 * One invocation per row, because both reduce along the last axis: 32 channels for the
 * cosine normalise, the window's token count for the softmax.
 *
 * Both reductions are reproduced in the order the reference uses, which had to be
 * measured rather than assumed. `sum(dtype=float16)` in numpy does *not* accumulate in
 * half — it runs sequentially in float32 and rounds once at the end — and the cosine
 * normalise instead uses a fixed fragment tree of half operations, whose shape is the
 * kernel's, not a reduction library's.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };

layout(push_constant, scalar) uniform Push {
    FloatBuf a, b, c, d;
    uint m, n, k, batch;
    uint sa, sb, sc, flags;
    float p0, p1, p2, p3;
} pc;

const uint COSINE_PUBLISH = 0u, SOFTMAX = 1u;
const float COSINE_NORM_FLOOR = 0.00006198883056640625;

float half_round(float x) {
    float magnitude = abs(x);
    if (magnitude >= 65520.0) return x < 0.0 ? -1.0 / 0.0 : 1.0 / 0.0;
    if (magnitude < 6.103515625e-05) return roundEven(x * 16777216.0) * 5.9604644775390625e-08;
    int bits = floatBitsToInt(x);
    bits = (bits + (0x0FFF + ((bits >> 13) & 1))) & ~0x1FFF;
    return intBitsToFloat(bits);
}

float e4m3(float x) {
    float magnitude = min(abs(x), 448.0);
    int exponent = (floatBitsToInt(magnitude) >> 23) & 0xFF;
    exponent = max(exponent, 121) - 3;
    float step = intBitsToFloat(exponent << 23);
    float reciprocal = intBitsToFloat((254 - exponent) << 23);
    float rounded = roundEven(magnitude * reciprocal) * step;
    return x < 0.0 ? -rounded : rounded;
}

/* half(l*r), half(l+r), half(l*r + acc) — each a float32 expression with one rounding
 * at the end, matching `_half_multiply` / `_half_add` / `_half_fma`. `precise` stops an
 * FMA contraction, which would drop the float32 rounding between the multiply and the
 * add and give a different answer. */
float hmul(float l, float r) { precise float t = l * r; return half_round(t); }
float hadd(float l, float r) { precise float t = l + r; return half_round(t); }
float hfma(float l, float r, float acc) { precise float t = l * r + acc; return half_round(t); }

void cosine_publish(uint row) {
    uint base = row * 32u;
    float h[32];
    for (uint i = 0u; i < 32u; i++) h[i] = half_round(pc.a.v[base + i]);

    float partial[4][2];
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint parity = 0u; parity < 2u; parity++) {
            uint ch = lane * 2u + parity;
            float first  = hfma(h[ch + 8u],  h[ch + 8u],  hmul(h[ch],       h[ch]));
            float second = hfma(h[ch + 24u], h[ch + 24u], hmul(h[ch + 16u], h[ch + 16u]));
            partial[lane][parity] = hadd(first, second);
        }
    float two[4][2], one[4][2];
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint p = 0u; p < 2u; p++) two[lane][p] = hadd(partial[lane][p], partial[lane ^ 2u][p]);
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint p = 0u; p < 2u; p++) one[lane][p] = hadd(two[lane][p], two[lane ^ 1u][p]);

    float norm = max(hadd(one[0][0], one[0][1]), half_round(COSINE_NORM_FLOOR));
    float reciprocal = half_round(inversesqrt(norm));
    // pc.k != 0 selects the query path, which also multiplies by its head's scale
    float scale = 1.0;
    if (pc.k != 0u) {
        uint head = (row / pc.n) % pc.batch;      // rows are (batch, head, token)
        scale = half_round(pc.d.v[head]);
    }
    for (uint i = 0u; i < 32u; i++) {
        float value = hmul(h[i], reciprocal);
        if (pc.k != 0u) value = hmul(value, scale);
        pc.c.v[base + i] = e4m3(value);
    }
}

void softmax(uint row) {
    /* `n` is the real token count and `sa` the row stride, which differ for the
     * global blocks: their token count is the bottleneck's pixel count and need not
     * be a multiple of the cooperative-matrix tile, so the scores are padded. The pad
     * must not enter the sum, and is zeroed so the following P@V contributes nothing.
     * `p0` is the symmetric logit clamp the vit_1d kernels apply; 0 means none. */
    uint stride = pc.sa != 0u ? pc.sa : pc.n;
    uint base = row * stride;
    for (uint i = pc.n; i < stride; i++) pc.c.v[base + i] = 0.0;
    // the affine map into the exponent's linear region, clamped
    // (see notes/phase5-softmax-found.md)
    float total = 0.0;
    for (uint i = 0u; i < pc.n; i += 2u) {
        uint bits[2];
        for (uint j = 0u; j < 2u; j++) {
            float logit = pc.a.v[base + i + j];
            if (pc.p0 != 0.0) logit = clamp(logit, -pc.p0, pc.p0);
            precise float scaled = half_round(logit) * 0.044921875;
            scaled += 1.30078125;
            float affine = clamp(scaled, 1.03125, 1.5693359375);
            // the float16 bit pattern of the affine value
            int f = floatBitsToInt(half_round(affine));
            bits[j] = uint(((f >> 13) & 0x3FF) | (((((f >> 23) & 0xFF) - 112) & 0x1F) << 10)
                           | ((f < 0) ? 0x8000 : 0));
        }
        uint packed = bits[0] | (bits[1] << 16);
        uint transformed = (packed << 5) + 0x7FF88000u;
        for (uint j = 0u; j < 2u; j++) {
            uint half_bits = (j == 0u) ? (transformed & 0xFFFFu) : ((transformed >> 16) & 0xFFFFu);
            uint exponent = (half_bits >> 10) & 0x1Fu, mantissa = half_bits & 0x3FFu;
            float weight = (exponent == 0u)
                ? float(mantissa) * 5.9604644775390625e-08
                : intBitsToFloat(int(((exponent + 112u) << 23) | (mantissa << 13)));
            if ((half_bits & 0x8000u) != 0u) weight = -weight;
            pc.c.v[base + i + j] = weight;
            total += weight;                      // float32 accumulation, as numpy does
        }
    }
    float reciprocal = half_round(1.0 / half_round(total));
    for (uint i = 0u; i < pc.n; i++)
        pc.c.v[base + i] = e4m3(hmul(pc.c.v[base + i], reciprocal));
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.m) return;
    if (pc.flags == COSINE_PUBLISH) cosine_publish(row);
    else if (pc.flags == SOFTMAX)   softmax(row);
}
