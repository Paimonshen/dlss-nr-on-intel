#!/usr/bin/env python3
"""nr-ctl — drive the running daemon and layer without restarting either.

The daemon holds the model, so restarting it to try another profile costs a second and
drops the layer's connection mid-game. Everything here is either a post-network knob or
the extent, so none of it invalidates the weights and all of it can move between frames.

    src/layer/nr-ctl                    an interactive session
    src/layer/nr-ctl on                 start enhancing (touches the trigger)
    src/layer/nr-ctl off                hand the game back
    src/layer/nr-ctl set scale 0.5      run the network at half of each side
    src/layer/nr-ctl status

Start the daemon so it watches the same file:

    python3 src/layer/nr_daemon.py --settings /tmp/nr_settings.json --render-scale 0.5

The trigger is what the layer polls; the settings file is what the daemon re-reads.
Neither needs the other, so `on`/`off` work even with no settings file, and a knob can
be changed while the effect is off.

`nr-toggle` is the same three files bound to a key, for when the game has the screen and
a terminal would mean alt-tabbing out of it.
"""
import pathlib
import sys
import textwrap

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import nr_knobs                                                        # noqa: E402
import nr_paths                                                        # noqa: E402

# Shared with `nr-toggle`, which is the same three paths bound to a key. They were
# written out here first and copying them was how they would have drifted.
SETTINGS, TRIGGER, SOCKET = nr_paths.SETTINGS, nr_paths.TRIGGER, nr_paths.SOCKET
read, write, alive = nr_paths.read, nr_paths.write, nr_paths.alive

# One table, shared with `nr-panel` and with the manual: a knob that exists in the daemon
# and not here is exactly the drift `nr_knobs` was written to stop, and it had already
# happened once (`hold`).
PROFILES = nr_knobs.PROFILES
KNOBS = tuple(knob.name for knob in nr_knobs.KNOBS)
ALIAS = {"p": "profile", "i": "intensity", "d": "detail_strength",
         "c": "colour_strength", "s": "render_scale", "scale": "render_scale",
         "detail": "detail_strength", "colour": "colour_strength",
         "color": "colour_strength", "t": "temporal", "history": "temporal",
         "cut": "cut_limit", "h": "hold"}

# Measured end to end on this machine, 2026-09-10 — the whole round trip through the
# socket, not the graph alone. `(swapchain width, height, render_scale) -> ms`.
# The network's cost follows the extent it is given and nothing else, but at these sizes
# the numpy either side of it — feature assembly and composition, both at the output
# resolution — is the larger half, so the swapchain size matters as much as the scale.
RATES = (
    (854, 480, 0.50, 180.1), (854, 480, 0.35, 176.6),
    (720, 405, 0.50, 200.1), (720, 405, 0.35, 207.9),
    (640, 360, 0.50, 199.8), (640, 360, 0.35, 116.8),
    (512, 288, 0.50, 108.3), (512, 288, 0.35, 98.6),
)
expected = nr_knobs.expected          # graph time against render scale, measured


def _opencv():
    """Whether the vendored blur will find its fast path."""
    try:
        import cv2                                  # noqa: F401
        return True
    except ImportError:
        return False


def status():
    values = read()
    print("  daemon    %s  (%s)" % ("listening" if alive() else "not answering", SOCKET))
    print("  effect    %s  (%s)" % ("ON" if TRIGGER.exists() else "off", TRIGGER))
    print("  settings  %s" % (SETTINGS if SETTINGS.exists() else "%s — not written yet" % SETTINGS))
    print("  blur      %s" % ("OpenCV fast path" if _opencv()
                              else "numpy fallback — the strength knobs cost 7x, not 2x"))
    for knob in KNOBS:
        shown = values.get(knob, "(daemon default)")
        note = ""
        if knob == "render_scale" and isinstance(shown, (int, float)):
            ms = expected(float(shown))
            note = "   ~%.0f ms, ~%.1f fps of graph time" % (ms, 1000.0 / ms)
        if knob == "temporal" and isinstance(shown, (int, float)):
            note = "   off — every frame is drawn alone" if not float(shown) else \
                   "   the previous frame is carried forward, gated per pixel"
        if knob == "hold" and isinstance(shown, (int, float)):
            note = "   off — the model's own gate alone" if not float(shown) else \
                   "   pixels the game did not move are held still"
        print("    %-16s %s%s" % (knob, shown, note))


def apply(knob, value):
    knob = ALIAS.get(knob, knob)
    if knob not in KNOBS:
        print("  no knob %r; try: %s" % (knob, ", ".join(KNOBS)))
        return
    entry = nr_knobs.BY_NAME[knob]
    if entry.kind == "choice":
        if value not in PROFILES:
            print("  profiles are: %s" % ", ".join(PROFILES))
            return
    else:
        try:
            value = float(value)
        except ValueError:
            print("  %s takes a number" % knob)
            return
        if not entry.low <= value <= entry.high:
            print("  %s is between %g and %g" % (knob, entry.low, entry.high))
            return
    values = read()
    values[knob] = value
    write(values)
    extra = ""
    if knob == "render_scale":
        ms = expected(value)
        extra = "   ~%.0f ms, ~%.1f fps of graph time" % (ms, 1000.0 / ms)
    print("  %s = %s%s" % (knob, value, extra))
    if knob in ("detail_strength", "colour_strength") and value != 1.0:
        # `compose_detail` returns early when both strengths are 1 and otherwise splits
        # the change into bands with a radius-4 Gaussian. The vendored blur takes
        # `cv2.sepFilter2D` when OpenCV is importable and an 18-pass numpy fallback when
        # it is not, and the difference is large enough to be worth reporting honestly.
        if _opencv():
            print("     note: away from 1 this adds a full-frame blur — 15 -> 32 ms at")
            print("     854x480, 2x the composition. OpenCV is installed, so this is")
            print("     the fast path already.")
        else:
            print("     note: away from 1 this adds a full-frame blur — 15 -> 110 ms at")
            print("     854x480, 7x the composition. Installing OpenCV takes that to")
            print("     32 ms; the vendored blur has the fast path and only needs it")
            print("     importable.")


def explain(name):
    """What a knob does, from the one table the panel and the manual also render."""
    entry = nr_knobs.BY_NAME.get(name)
    if entry is None:
        print("  no knob %r; try: %s" % (name, ", ".join(KNOBS)))
        return
    if entry.kind == "choice":
        span = " | ".join(PROFILES)
    else:
        span = "%g to %g, step %g, daemon default %g" % (
            entry.low, entry.high, entry.step, entry.default)
    print("  %s — %s" % (entry.label, entry.summary))
    print("  %s\n" % span)
    for line in textwrap.wrap(entry.detail.replace("*", ""), 76):
        print("  " + line)


def command(words):
    if not words:
        return True
    head, rest = words[0].lower(), words[1:]
    if head in ("q", "quit", "exit"):
        return False
    if head == "on":
        TRIGGER.parent.mkdir(parents=True, exist_ok=True)
        TRIGGER.touch()
        print("  effect ON")
    elif head == "off":
        TRIGGER.unlink(missing_ok=True)
        print("  effect off")
    elif head in ("status", "st", ""):
        status()
    elif head == "set" and len(rest) == 2:
        apply(rest[0], rest[1])
    elif head in ALIAS or head in KNOBS:
        if len(rest) != 1:
            print("  %s <value>" % head)
        else:
            apply(head, rest[0])
    elif head in ("rates", "fps"):
        print("  measured end to end, whole round trip (2026-09-10):\n")
        print("    %-14s %8s %9s %8s" % ("swapchain", "scale", "ms", "fps"))
        for width, height, scale, ms in RATES:
            print("    %-14s %8.2f %9.1f %8.2f"
                  % ("%dx%d" % (width, height), scale, ms, 1000.0 / ms))
        print("\n  Set the *game* to the swapchain size; the compositor stretches the")
        print("  result to the panel for nothing. The odd non-monotonic rows are the")
        print("  network's alignment padding, which some extents land badly on.")
    elif head in ("help", "?", "man"):
        if rest:
            explain(ALIAS.get(rest[0], rest[0]))
        else:
            print("  on | off | status | rates | set <knob> <value> | help <knob> | q")
            print("  shorthand: p <profile>, i <n>, d <n>, c <n>, s <scale>, t <0-1>")
            print("  knobs: %s" % ", ".join(KNOBS))
            print("  `help <knob>` says what one actually does, and what it costs.")
    else:
        print("  ? %s   (try `help`)" % " ".join(words))
    return True


def main():
    if len(sys.argv) > 1:
        command(sys.argv[1:])
        return 0
    print("nr-ctl — `help` for commands, `q` to leave. The daemon and the game keep running.\n")
    status()
    while True:
        try:
            line = input("\nnr> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not command(line.split()):
            return 0


if __name__ == "__main__":
    sys.exit(main())
